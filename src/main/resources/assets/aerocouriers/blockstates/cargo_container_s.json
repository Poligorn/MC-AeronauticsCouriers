    { "when": { "facing": "west", "waybill": false }, "apply": { "model": "aerocouriers:block/cargo_container_s", "y": 270 } },
    { "when": { "facing": "north", "waybill": true }, "apply": { "model": "aerocouriers:block/cargo_container_s_waybill", "y": 0 } },
    { "when": { "facing": "east", "waybill": true }, "apply": { "model": "aerocouriers:block/cargo_container_s_waybill", "y": 90 } },
